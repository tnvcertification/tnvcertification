{
  "name": "tnv-certification",
  "version": "0.1.0",
  "private": true,
  "description": "PT. Intiprima Sertifikasi - website content-driven Astro + TypeScript + Tailwind CSS",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "tsc --noEmit --runExternalCode",
    "check": "astro sync && tsc --noEmit --runExternalCode",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/**/*.test.mjs",
    "format": "prettier --write .",
    "preview": "astro preview",
    "audit:seo": "node scripts/audit-seo-build.mjs",
    "audit:blocks": "node scripts/audit-block-sections.mjs",
    "audit:page-images": "node scripts/audit-page-images.mjs",
    "audit:headings": "node scripts/audit-heading-hierarchy.mjs",
    "validate:changed": "node --import tsx scripts/validate-changed-content.mjs",
    "images:illustrations": "node scripts/convert-illustrations.mjs",
    "predev": "pnpm images:illustrations",
    "prebuild": "pnpm images:illustrations"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "mdast-util-to-string": "4.0.0",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.3.5",
    "tinyglobby": "0.2.17",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@eslint/js": "10.0.1",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "7.1.0-beta",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  }
}

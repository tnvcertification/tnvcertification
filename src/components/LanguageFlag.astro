---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

{
  lang === "id" ? (
    <svg viewBox="0 0 24 12" class="h-4 w-6" aria-hidden="true" focusable="false">
      <rect width="24" height="12" fill="#FFFFFF" />
      <path d="M0 0h24v6H0z" fill="#CE1126" />
      <rect
        x="0.5"
        y="0.5"
        width="23"
        height="11"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
      />
    </svg>
  ) : (
    <svg viewBox="0 0 60 30" class="h-4 w-6" aria-hidden="true" focusable="false">
      <rect width="60" height="30" fill="#012169" />
      <path d="M0 0l60 30M60 0L0 30" stroke="#FFFFFF" stroke-width="6" />
      <path d="M0 0l60 30M60 0L0 30" stroke="#C8102E" stroke-width="2" />
      <path d="M30 0v30M0 15h60" stroke="#FFFFFF" stroke-width="10" />
      <path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6" />
      <rect
        x="0.5"
        y="0.5"
        width="59"
        height="29"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
      />
    </svg>
  )
}

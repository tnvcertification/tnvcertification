---
import { organization, siteSettings, primaryNavigation } from "../site";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === "/") return currentPath === "/";
  if (href === "/services/") {
    return currentPath === href || currentPath.startsWith("/services/");
  }
  return currentPath === href || currentPath.startsWith(href);
};
---
<header class="border-b border-border bg-page">
  <div class="mx-auto flex max-w-[var(--content-wide)] flex-col gap-4 px-[var(--page-gutter)] py-4 md:flex-row md:items-center md:justify-between">
    <a href="/" class="group flex items-center gap-3 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-blue" aria-label={`${organization.name} — beranda`}>
      <img src={organization.logo.url} width="240" height="64" alt={`${organization.groupName} — ${organization.name}`} class="h-12 w-auto max-w-[min(72vw,240px)] object-contain object-left" />
      <span class="sr-only">{siteSettings.title}</span>
    </a>
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-end md:gap-4">
      <nav aria-label="Navigasi utama">
        <ul class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold">
          {primaryNavigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class:list={[
                  "inline-flex border-b-2 px-3 py-2 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue",
                  isCurrent(item.href) ? "border-brand-deepblue text-brand-deepblue" : "border-transparent text-ink-muted hover:border-border-strong hover:text-ink",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <LanguageSwitcher lang={lang} />
    </div>
  </div>
</header>

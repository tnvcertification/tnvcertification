---
import Section from "../Section.astro";
import type { LinkGridBlock } from "../../data/pages";

interface Props {
  block: LinkGridBlock;
}

const { block } = Astro.props;
const headingId = block.title && block.id ? `${block.id}-heading` : undefined;
---

<Section id={block.id} aria-labelledby={headingId} spacing="spacious">
  {block.eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-subtle">{block.eyebrow}</p>}
  {block.title && <h2 id={headingId} class="mt-2 text-2xl font-semibold tracking-tight text-ink">{block.title}</h2>}
  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    {block.items.map((item) => (
      <a href={item.href} class="group flex h-full flex-col border-t-2 border-brand-deepblue py-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-blue">
        {item.eyebrow && <span class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-subtle">{item.eyebrow}</span>}
        <h3 class="mt-3 text-xl font-semibold tracking-tight text-ink group-hover:text-brand-deepblue">{item.title}</h3>
        {item.description && <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-muted">{item.description}</p>}
        {item.actionLabel && <span class="mt-auto inline-flex min-h-11 items-center pt-4 text-sm font-semibold text-brand-deepblue group-hover:underline">{item.actionLabel}</span>}
      </a>
    ))}
  </div>
</Section>

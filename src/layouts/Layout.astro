---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Container from "../components/Container.astro";
import { buildSeo, type LayoutProps } from "../lib/seo";
import { pageJsonLdGraph, serializeJsonLd } from "../lib/structured-data";

export type Props = LayoutProps;
const { structuredData = [] } = Astro.props;
const seo = buildSeo(Astro.props);
const jsonLd = serializeJsonLd(pageJsonLdGraph(structuredData));
---
<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B2A4A" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={seo.openGraph.type} />
    <meta property="og:site_name" content={seo.openGraph.siteName} />
    <meta property="og:locale" content={seo.openGraph.locale} />
    <meta property="og:title" content={seo.openGraph.title} />
    <meta property="og:description" content={seo.openGraph.description} />
    <meta property="og:url" content={seo.openGraph.url} />
    {seo.openGraph.images.map((image) => <meta property="og:image" content={image.url} />)}
    <meta name="twitter:card" content={seo.twitter.card} />
    <meta name="twitter:title" content={seo.twitter.title} />
    <meta name="twitter:description" content={seo.twitter.description} />
    {seo.twitter.images.map((image) => <meta name="twitter:image" content={image} />)}
    {seo.hreflang.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body id="top" class="flex min-h-screen flex-col bg-page text-ink">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-brand-deepblue focus:shadow-lg">
      Lewati ke konten utama
    </a>
    <SiteHeader lang={seo.lang} />
    <main id="main-content" class="flex w-full flex-1">
      <Container variant="landing" class="py-8 sm:py-10 lg:py-12">
        <slot />
      </Container>
    </main>
    <SiteFooter />
  </body>
</html>

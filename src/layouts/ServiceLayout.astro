---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Container from "../components/Container.astro";
import PageHero from "../components/page/PageHero.astro";
import PageBlockRenderer from "../components/page/PageBlockRenderer.astro";
import type { HeroBlock, PageBlock } from "../data/pages";

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  imageAlt: string;
  structuredData?: unknown[];
  breadcrumbs?: Array<{ label: string; href?: string }>;
  hero: HeroBlock;
  blocks: PageBlock[];
}

const {
  title,
  description,
  lang,
  canonical,
  ogImage,
  imageAlt,
  structuredData = [],
  breadcrumbs = [],
  hero,
  blocks,
} = Astro.props;
const fallbackImage = { src: ogImage ?? "", alt: imageAlt };
---

<Layout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage} structuredData={structuredData}>
  <Container as="article" variant="wide" gutter={false}>
    <Breadcrumbs items={breadcrumbs} lang={lang === "en" ? "en" : "id"} />
    {hero && <PageHero block={hero} fallbackImage={fallbackImage} />}
    <PageBlockRenderer blocks={blocks} fallbackImage={fallbackImage} />
    <slot />
  </Container>
</Layout>

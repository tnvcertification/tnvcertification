---
import { getCollection } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import type { HeroBlock, PageBlock } from "../../data/pages";
import { siteCrumb } from "../../data/breadcrumbs";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => data.draft !== true);
  return articles.map((entry) => {
    const pubDate = entry.data.pubDate;
    const featuredImage = entry.data.featuredImage;
    if (!(pubDate instanceof Date) || !featuredImage) {
      throw new Error(`Published article "${entry.id}" is missing its approved pubDate or featuredImage.`);
    }
    const translationPair = articles.filter(
      (candidate) => candidate.data.translationKey === entry.data.translationKey,
    );
    const alternates = translationPair.length > 1
      ? translationPair.map((candidate) => ({
          lang: candidate.data.lang,
          href: `/articles/${candidate.data.slug}/`,
        }))
      : [];
    return {
      params: { slug: entry.data.slug },
      props: { entry, alternates, pubDate, featuredImage },
    };
  });
}
const { entry, alternates, pubDate, featuredImage } = Astro.props;
const canonical = `/articles/${entry.data.slug}/`;
const allBlocks = entry.data.blocks ?? [];
const hero = allBlocks.find((block): block is HeroBlock => block.type === "hero");
if (!hero) throw new Error(`Article "${entry.id}" is missing a hero block.`);
const blocks: PageBlock[] = allBlocks.filter((block) => block.type !== "hero");
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.metaDescription}
  lang={entry.data.lang}
  canonical={canonical}
  ogImage={featuredImage.src}
  date={entry.data.updatedDate ?? pubDate}
  imageAlt={featuredImage.alt}
  alternates={alternates}
  breadcrumbs={[siteCrumb("/"), siteCrumb("/articles/"), { label: entry.data.title }]}
  hero={hero}
  blocks={blocks}
/>

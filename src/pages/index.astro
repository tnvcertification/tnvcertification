---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import PageHero from "../components/page/PageHero.astro";
import LinkGrid from "../components/page/LinkGrid.astro";
import ListingSection from "../components/page/ListingSection.astro";
import { getHomepageArticles, getPublishedArticles } from "../data/articles";
import {
  getPageBlocks,
  getPageEntry,
  getPageHero,
  type LinkGridBlock,
  type ListingBlock,
} from "../data/pages";

const entry = await getPageEntry("home");
const hero = getPageHero(entry);
const blocks = getPageBlocks(entry);
const fallbackImage = { src: entry.data.featuredImage.src, alt: entry.data.featuredImage.alt };
const articles = getHomepageArticles(getPublishedArticles());
const linkGrids = blocks.filter((block): block is LinkGridBlock => block.type === "link-grid");
const listings = blocks.filter((block): block is ListingBlock => block.type === "listing");
---

<Layout title={entry.data.title} description={entry.data.metaDescription} ogImage={fallbackImage.src}>
  <div class="w-full">
    {hero && <PageHero block={hero} fallbackImage={fallbackImage} />}
    {linkGrids.map((block) => <LinkGrid block={block} />)}
    {listings.map((block) => (
      <ListingSection block={block} hasItems={articles.length > 0}>
        <div class="grid gap-8 md:grid-cols-3">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      </ListingSection>
    ))}
  </div>
</Layout>

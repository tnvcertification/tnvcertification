---
import ScheduleArchiveLayout from "../../layouts/ScheduleArchiveLayout.astro";
import ListingSection from "../../components/page/ListingSection.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import { getCollection } from "astro:content";
import {
  getPageBlocks,
  getPageEntry,
  getPageHero,
  type ListingBlock,
} from "../../data/pages";

const entry = await getPageEntry("schedules");
const hero = getPageHero(entry);
const listings = getPageBlocks(entry).filter((block): block is ListingBlock => block.type === "listing");
const fallbackImage = { src: entry.data.featuredImage.src, alt: entry.data.featuredImage.alt };

const [schedules, trainings] = await Promise.all([
  getCollection("trainingSchedules"),
  getCollection(
    "training",
    ({ data }) => data.draft !== true && data.lang === "id",
  ),
]);

const trainingBySlug = new Map(
  trainings.map((training) => [training.data.slug, training]),
);

const publishedSchedules = schedules
  .filter(
    (schedule) =>
      schedule.data.registrationStatus !== "cancelled" &&
      trainingBySlug.has(schedule.data.trainingSlug),
  )
  .sort((a, b) =>
    a.data.startDate.localeCompare(b.data.startDate) ||
    a.data.slug.localeCompare(b.data.slug),
  );

const formatDate = (value: string) =>
  new Date(`${value}T00:00:00Z`).toLocaleDateString("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });

const statusLabel = (status?: string) => ({
  open: "Pendaftaran dibuka",
  closed: "Pendaftaran ditutup",
  full: "Kuota terpenuhi",
}[status ?? ""] ?? "Informasi pendaftaran menyusul");
---

<ScheduleArchiveLayout
  title={hero?.title ?? entry.data.title}
  description={hero?.description ?? entry.data.intro}
  canonical="/schedules/"
  lang={entry.data.lang}
  image={hero?.image ?? fallbackImage.src}
  imageAlt={hero?.imageAlt ?? fallbackImage.alt}
  eyebrow={hero?.eyebrow}
>
  {listings.map((block) => (
    <ListingSection block={block} hasItems={publishedSchedules.length > 0}>
      <div class="divide-y divide-border border-y border-border">
        {publishedSchedules.map((schedule) => {
          const training = trainingBySlug.get(schedule.data.trainingSlug)!;
          return (
            <article class="grid gap-4 py-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
              <div>
                <p class="text-sm font-semibold text-ink-muted">
                  {formatDate(schedule.data.startDate)} – {formatDate(schedule.data.endDate)}
                </p>
                <h2 class="mt-2 text-xl font-semibold tracking-tight text-ink">
                  <a href={`/trainings/${training.data.slug}/`} class="hover:text-brand-blue">
                    {training.data.title}
                  </a>
                </h2>
                <p class="mt-2 text-sm text-ink-muted">
                  {schedule.data.locationType === "online" ? "Online" : schedule.data.locationType === "hybrid" ? "Hybrid" : schedule.data.locationType === "offline" ? "Tatap muka" : "Metode menyusul"}
                  {(schedule.data.venue || schedule.data.city) && ` · ${[schedule.data.venue, schedule.data.city, schedule.data.province].filter(Boolean).join(", ")}`}
                </p>
                <p class="mt-2 text-sm font-medium text-ink">{statusLabel(schedule.data.registrationStatus)}</p>
                {schedule.data.price !== undefined && (
                  <p class="mt-1 text-sm text-ink-muted">
                    Biaya: {schedule.data.currency === "IDR" || !schedule.data.currency ? "Rp " : `${schedule.data.currency} `}
                    {schedule.data.price.toLocaleString("id-ID")}
                  </p>
                )}
              </div>
              <div class="flex flex-wrap gap-3 md:justify-end">
                <ButtonLink href={`/trainings/${training.data.slug}/`} variant="secondary" class="px-4 py-2">
                  Detail program
                </ButtonLink>
                {schedule.data.registrationUrl && schedule.data.registrationStatus === "open" && (
                  <ButtonLink href={schedule.data.registrationUrl} class="px-4 py-2">
                    Daftar
                  </ButtonLink>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </ListingSection>
  ))}
</ScheduleArchiveLayout>

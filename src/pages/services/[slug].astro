---
import { render } from "astro:content";
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getPublishedArticles, getRelatedArticles } from "../../data/articles";
import { getPublishedServices, servicePath } from "../../data/services";
import { servicePageJsonLd } from "../../lib/structured-data";

export async function getStaticPaths() {
  const services = await getPublishedServices("id");
  return services.map((service) => ({ params: { slug: service.data.slug }, props: { service } }));
}
const { service } = Astro.props;
const { Content } = await render(service);
const serviceId = service.data.id;
const relatedArticles = serviceId ? getRelatedArticles(getPublishedArticles(), serviceId) : [];
const structuredData = servicePageJsonLd({
  name: service.data.title,
  description: service.data.metaDescription,
  path: servicePath(service.data),
  image: service.data.featuredImage.src,
  serviceType: service.data.serviceType,
  category: service.data.category,
});
---

<ServiceLayout
  title={service.data.title}
  description={service.data.metaDescription}
  lang={service.data.lang}
  canonical={servicePath(service.data)}
  ogImage={service.data.featuredImage.src}
  imageAlt={service.data.featuredImage.alt}
  blocks={service.data.blocks}
  structuredData={structuredData}
>
  <Content />
  {relatedArticles.length > 0 && (
    <section class="mt-16" aria-labelledby="artikel-terkait">
      <h2 id="artikel-terkait" class="text-2xl font-semibold text-brand-deepblue">Artikel Terkait</h2>
      <div class="mt-6 grid gap-8 md:grid-cols-2">
        {relatedArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>
  )}
</ServiceLayout>

---
import WidePageLayout from "../../layouts/WidePageLayout.astro";
import PageHero from "../../components/page/PageHero.astro";
import ListingSection from "../../components/page/ListingSection.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { getPublishedArticles, getServiceIndexArticles } from "../../data/articles";
import { getPublishedServices, servicePath } from "../../data/services";
import { getPageBlocks, getPageEntry, getPageHero, type ListingBlock } from "../../data/pages";
import { siteSettings } from "../../site";
import { serviceIndexJsonLd } from "../../lib/structured-data";

const entry = await getPageEntry("services");
const hero = getPageHero(entry);
const listings = getPageBlocks(entry).filter((block): block is ListingBlock => block.type === "listing");
const fallbackImage = { src: entry.data.featuredImage.src, alt: entry.data.featuredImage.alt };
const services = await getPublishedServices("id");
const articles = getServiceIndexArticles(getPublishedArticles());
const structuredData = serviceIndexJsonLd(
  services.map((service) => ({
    name: service.data.title,
    description: service.data.metaDescription,
    path: servicePath(service.data),
  })),
);
---

<WidePageLayout
  title={`${entry.data.title} | ${siteSettings.title}`}
  description={entry.data.metaDescription}
  canonical="/services/"
  lang={entry.data.lang}
  ogImage={fallbackImage.src}
  structuredData={structuredData}
>
  <div class="w-full">
    {hero && <PageHero block={hero} fallbackImage={fallbackImage} />}
    {listings.map((block) => block.source === "services" ? (
      <ListingSection block={block} hasItems={services.length > 0}>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <ServiceCard
              title={service.data.title}
              description={service.data.intro}
              href={servicePath(service.data)}
            />
          ))}
        </div>
      </ListingSection>
    ) : block.source === "articles" ? (
      <ListingSection block={block} hasItems={articles.length > 0}>
        <div class="grid gap-8 md:grid-cols-3">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      </ListingSection>
    ) : null)}
  </div>
</WidePageLayout>

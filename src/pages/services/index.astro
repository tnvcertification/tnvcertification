---
import WidePageLayout from "../../layouts/WidePageLayout.astro";
import MainMenuHero from "../../components/MainMenuHero.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import Section from "../../components/Section.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getPublishedArticles, getServiceIndexArticles } from "../../data/articles";
import { getPublishedServices, servicePath } from "../../data/services";
import { siteSettings } from "../../site";
import { serviceIndexJsonLd } from "../../lib/structured-data";
const services = await getPublishedServices("id");
const articles = getServiceIndexArticles(getPublishedArticles());
const structuredData = serviceIndexJsonLd(
  services.map((service) => ({
    name: service.data.title,
    description: service.data.metaDescription,
    path: servicePath(service.data),
  })),
);
---
<WidePageLayout title={`Layanan | ${siteSettings.title}`} description="Layanan sertifikasi, pelatihan, dan penilaian kepatuhan." canonical="/services/" lang="id" ogImage="/images/illustrations/services-assessment.webp" structuredData={structuredData}>
  <div class="w-full">
    <MainMenuHero
      eyebrow="Layanan profesional"
      title="Layanan Kami"
      description="Layanan sertifikasi, pelatihan, dan penilaian kepatuhan untuk mendukung organisasi dalam meningkatkan mutu, kompetensi, dan keandalan proses."
      image="/images/illustrations/services-assessment.webp"
      imageAlt="Ilustrasi proses asesmen layanan sertifikasi dan evaluasi kepatuhan"
    />
    {services.length > 0 ? (
      <Section spacing="default" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.intro}
            href={servicePath(service.data)}
          />
        ))}
      </Section>
    ) : <Section spacing="default"><p>Informasi layanan akan segera tersedia.</p></Section>}
    {articles.length > 0 && (
      <Section spacing="spacious" aria-labelledby="artikel-terbaru-layanan">
        <SectionHeading id="artikel-terbaru-layanan" title="Artikel Terbaru" />
        <div class="mt-6 grid gap-8 md:grid-cols-3">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      </Section>
    )}
  </div>
</WidePageLayout>
